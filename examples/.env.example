# Image tag: latest for releases, develop for development builds.
SUBMARINE_TAG=latest

# Folder that holds both your downloads and your library.
MEDIA_PATH=/srv/media

# User and group that own MEDIA_PATH (run `id` on the host).
PUID=1000
PGID=1000
TZ=Etc/UTC

# Shared secret between Submarine and its metadata and mappings services.
# Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=

# https://www.themoviedb.org/settings/api (API key, v3)
TMDB_API_KEY=
# https://thetvdb.com/api-information (API key, plus the subscriber PIN if your key needs one)
TVDB_API_KEY=
TVDB_PIN=

# Only used with the postgres profile.
POSTGRES_PASSWORD=
