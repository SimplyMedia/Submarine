{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft.AspNetCore": "Warning",
				"Microsoft.EntityFrameworkCore.Database": "Warning",
				"Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
			}
		}
	},
	"ConnectionStrings": {
		"SqliteConnection": "Data Source=data/mappings.db"
	},
	"Swagger": {
		"Enabled": true
	},
	"AllowedHosts": "*"
}
