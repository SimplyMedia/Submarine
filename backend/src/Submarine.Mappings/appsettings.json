{
	"Database": {
		"Provider": "Sqlite"
	},
	"ConnectionStrings": {
		"SqliteConnection": "Data Source=data/mappings.db;Cache=Shared",
		"PostgresConnection": "Host=localhost;Database=submarine_mappings;Username=postgres;Password=postgres"
	},
	"Swagger": {
		"Enabled": true
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.EntityFrameworkCore.Database": "Error",
				"Microsoft.EntityFrameworkCore.Infrastructure": "Error"
			}
		}
	},
	"AllowedHosts": "*"
}
